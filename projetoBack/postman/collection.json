{
  "info": {
    "name": "ECOWATT",
    "description": "Coleção para testar APIs do sistema de gestão de energia elétrica",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "{{token}}",
      "type": "string"
    },
    {
      "key": "token_user1",
      "value": "",
      "type": "string"
    },
    {
      "key": "token_user2",
      "value": "",
      "type": "string"
    },
    {
      "key": "aparelho_user1_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "aparelho_user2_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"testuser\",\n    \"password\": \"test123\"\n}"
            },
            "url": {
              "raw": "http://127.0.0.1:8000/api/login/",
              "host": ["http://127.0.0.1:8000"],
              "path": ["api", "login", ""]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    pm.environment.set('token', response.token);",
                  "    pm.test('Token saved', function () {",
                  "        pm.expect(response.token).to.not.be.undefined;",
                  "    });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Token {{token}}"
              }
            ],
            "url": {
              "raw": "http://127.0.0.1:8000/api/usuarios/logout/",
              "host": ["http://127.0.0.1:8000"],
              "path": ["api", "usuarios", "logout", ""]
            }
          }
        }
      ]
    },
    {
      "name": "Gestão",
      "item": [
        {
          "name": "Listar Aparelhos",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Token {{token}}"
              }
            ],
            "url": {
              "raw": "http://127.0.0.1:8000/api/gestao/aparelhos/",
              "host": ["http://127.0.0.1:8000"],
              "path": ["api", "gestao", "aparelhos", ""]
            }
          }
        },
        {
          "name": "Criar Aparelho",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Token {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"aparelho\": \"Geladeira\",\n    \"consumo\": \"150\",\n    \"tempo\": \"24\",\n    \"dias_de_uso\": 30\n}"
            },
            "url": {
              "raw": "http://127.0.0.1:8000/api/gestao/aparelhos/",
              "host": ["http://127.0.0.1:8000"],
              "path": ["api", "gestao", "aparelhos", ""]
            }
          }
        },
        {
          "name": "Atualizar Aparelho",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Token {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"aparelho\": \"Geladeira Atualizada\",\n    \"consumo\": \"180\",\n    \"tempo\": \"24\",\n    \"dias_de_uso\": 30\n}"
            },
            "url": {
              "raw": "http://127.0.0.1:8000/api/gestao/aparelhos/{{aparelho_id}}/",
              "host": ["http://127.0.0.1:8000"],
              "path": ["api", "gestao", "aparelhos", "{{aparelho_id}}", ""]
            }
          }
        },
        {
          "name": "Deletar Aparelho",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Token {{token}}"
              }
            ],
            "url": {
              "raw": "http://127.0.0.1:8000/api/gestao/aparelhos/{{aparelho_id}}/",
              "host": ["http://127.0.0.1:8000"],
              "path": ["api", "gestao", "aparelhos", "{{aparelho_id}}", ""]
            }
          }
        },
        {
          "name": "Listar Análises",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Token {{token}}"
              }
            ],
            "url": {
              "raw": "http://127.0.0.1:8000/api/gestao/analises/",
              "host": ["http://127.0.0.1:8000"],
              "path": ["api", "gestao", "analises", ""]
            }
          }
        }
      ]
    },
    {
      "name": "Testes de Segurança",
      "item": [
        {
          "name": "Setup - Login Usuários de Teste",
          "item": [
            {
              "name": "Login User1",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n    \"username\": \"user1\",\n    \"password\": \"test123\"\n}"
                },
                "url": {
                  "raw": "{{base_url}}/api/login/",
                  "host": ["{{base_url}}"],
                  "path": ["api", "login", ""]
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "if (pm.response.code === 200) {",
                      "    const response = pm.response.json();",
                      "    pm.collectionVariables.set('token_user1', response.token);",
                      "    pm.test('User1 token saved', function () {",
                      "        pm.expect(response.token).to.not.be.undefined;",
                      "    });",
                      "}"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Login User2",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n    \"username\": \"user2\",\n    \"password\": \"test123\"\n}"
                },
                "url": {
                  "raw": "{{base_url}}/api/login/",
                  "host": ["{{base_url}}"],
                  "path": ["api", "login", ""]
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "if (pm.response.code === 200) {",
                      "    const response = pm.response.json();",
                      "    pm.collectionVariables.set('token_user2', response.token);",
                      "    pm.test('User2 token saved', function () {",
                      "        pm.expect(response.token).to.not.be.undefined;",
                      "    });",
                      "}"
                    ]
                  }
                }
              ]
            }
          ]
        },
        {
          "name": "Criar Dados de Teste",
          "item": [
            {
              "name": "User1 - Criar Aparelho",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Token {{token_user1}}"
                  },
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n    \"aparelho\": \"Geladeira User1\",\n    \"consumo\": \"150\",\n    \"tempo\": \"24\",\n    \"dias_de_uso\": 30\n}"
                },
                "url": {
                  "raw": "{{base_url}}/api/gestao/aparelhos/",
                  "host": ["{{base_url}}"],
                  "path": ["api", "gestao", "aparelhos", ""]
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "if (pm.response.code === 201) {",
                      "    const response = pm.response.json();",
                      "    pm.collectionVariables.set('aparelho_user1_id', response.id);",
                      "    pm.test('User1 aparelho created', function () {",
                      "        pm.expect(response.aparelho).to.equal('Geladeira User1');",
                      "    });",
                      "}"
                    ]
                  }
                }
              ]
            },
            {
              "name": "User2 - Criar Aparelho",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Token {{token_user2}}"
                  },
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n    \"aparelho\": \"TV User2\",\n    \"consumo\": \"100\",\n    \"tempo\": \"8\",\n    \"dias_de_uso\": 30\n}"
                },
                "url": {
                  "raw": "{{base_url}}/api/gestao/aparelhos/",
                  "host": ["{{base_url}}"],
                  "path": ["api", "gestao", "aparelhos", ""]
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "if (pm.response.code === 201) {",
                      "    const response = pm.response.json();",
                      "    pm.collectionVariables.set('aparelho_user2_id', response.id);",
                      "    pm.test('User2 aparelho created', function () {",
                      "        pm.expect(response.aparelho).to.equal('TV User2');",
                      "    });",
                      "}"
                    ]
                  }
                }
              ]
            }
          ]
        },
        {
          "name": "Teste Segurança - Exclusão Cruzada",
          "item": [
            {
              "name": "❌ User1 tenta deletar aparelho do User2 (DEVE FALHAR)",
              "request": {
                "method": "DELETE",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Token {{token_user1}}"
                  }
                ],
                "url": {
                  "raw": "{{base_url}}/api/gestao/aparelhos/{{aparelho_user2_id}}/",
                  "host": ["{{base_url}}"],
                  "path": ["api", "gestao", "aparelhos", "{{aparelho_user2_id}}", ""]
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "pm.test('User1 CANNOT delete User2 aparelho', function () {",
                      "    pm.expect(pm.response.code).to.be.oneOf([403, 404]);",
                      "});"
                    ]
                  }
                }
              ]
            },
            {
              "name": "❌ User2 tenta deletar aparelho do User1 (DEVE FALHAR)",
              "request": {
                "method": "DELETE",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Token {{token_user2}}"
                  }
                ],
                "url": {
                  "raw": "{{base_url}}/api/gestao/aparelhos/{{aparelho_user1_id}}/",
                  "host": ["{{base_url}}"],
                  "path": ["api", "gestao", "aparelhos", "{{aparelho_user1_id}}", ""]
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "pm.test('User2 CANNOT delete User1 aparelho', function () {",
                      "    pm.expect(pm.response.code).to.be.oneOf([403, 404]);",
                      "});"
                    ]
                  }
                }
              ]
            }
          ]
        },
        {
          "name": "Teste Positivo - Próprios Dados",
          "item": [
            {
              "name": "✅ User1 deleta seu próprio aparelho",
              "request": {
                "method": "DELETE",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Token {{token_user1}}"
                  }
                ],
                "url": {
                  "raw": "{{base_url}}/api/gestao/aparelhos/{{aparelho_user1_id}}/",
                  "host": ["{{base_url}}"],
                  "path": ["api", "gestao", "aparelhos", "{{aparelho_user1_id}}", ""]
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "pm.test('User1 CAN delete own aparelho', function () {",
                      "    pm.expect(pm.response.code).to.equal(204);",
                      "});"
                    ]
                  }
                }
              ]
            },
            {
              "name": "✅ User2 deleta seu próprio aparelho",
              "request": {
                "method": "DELETE",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Token {{token_user2}}"
                  }
                ],
                "url": {
                  "raw": "{{base_url}}/api/gestao/aparelhos/{{aparelho_user2_id}}/",
                  "host": ["{{base_url}}"],
                  "path": ["api", "gestao", "aparelhos", "{{aparelho_user2_id}}", ""]
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "pm.test('User2 CAN delete own aparelho', function () {",
                      "    pm.expect(pm.response.code).to.equal(204);",
                      "});"
                    ]
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}